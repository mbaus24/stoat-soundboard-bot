BOT_TOKEN=your_bot_token_here
# Stoat - instance custom ex: https://trans.girls.rocks/api
STOAT_BASE_URL=https://stoat.chat/api
VOICE_CHANNEL_ID=
PREFIX=!sb
MAX_FILE_SIZE_MB=8
# Web UI (accessible uniquement via WireGuard sur 192.168.1.83)
WEB_PORT=3000
# Optionnel: protège l'UI/API (sinon ouvert sur ton WG)
WEB_PASSWORD=
